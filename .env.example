NODE_ENV=development
PORT=3000
API_PORT=3000
# Authorized web client origins, not the public API URL. Local development example:
WEB_ORIGINS=http://localhost:5173
# In production use only explicitly approved HTTPS clients; empty denies web commands.
# Exact IPs of trusted cloudflared connectors; empty disables forwarded client IPs.
# CIDRs, wildcards and arbitrary proxy hops are not accepted.
CLOUDFLARED_TRUSTED_IPS=
DATABASE_URL=mysql://wapphub:CHANGE_ME@wapphub-db:3306/wapphub
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
REDIS_URL=redis://wapphub-redis:6379
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
SESSION_ABSOLUTE_SECONDS=43200
SESSION_IDLE_SECONDS=1800
