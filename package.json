{
  "name": "wapphub-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/api.ts",
    "start": "node dist/src/api.js",
    "worker": "node dist/src/worker.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:validate": "tsx scripts/validate-openapi.ts",
    "smoke:chat": "tsx scripts/smoke-chat.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/websocket": "^11.3.3",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "ws": "^8.22.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
