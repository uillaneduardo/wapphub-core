generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  assignedConversations Conversation[]                  @relation("ConversationAssignee")
  chatMessages          Message[]                       @relation("MessageSender")
  chatNotes             InternalNote[]                  @relation("NoteAuthor")
  chatAssignments       ConversationAssignmentHistory[] @relation("AssignmentActor")
  invitations           OrganizationInvitation[]        @relation("InvitationAuthor")
  id                    String                          @id @default(uuid()) @db.Char(36)
  name                  String                          @db.VarChar(120)
  email                 String                          @unique @db.VarChar(254)
  passwordHash          String                          @db.VarChar(255)
  status                String                          @default("ACTIVE") @db.VarChar(20)
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  memberships           Membership[]
  sessions              Session[]
}

model Organization {
  contacts       Contact[]
  conversations  Conversation[]
  tags           Tag[]
  realtimeEvents RealtimeEvent[]
  sessions       Session[]
  id             String                   @id @default(uuid()) @db.Char(36)
  name           String                   @db.VarChar(120)
  status         String                   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  memberships    Membership[]
  invitations    OrganizationInvitation[]
  channels       Channel[]
}

model Membership {
  permissionVersion Int @default(0)
  permissionOverrides MembershipPermissionOverride[]
  id             String       @id @default(uuid()) @db.Char(36)
  userId         String       @db.Char(36)
  organizationId String       @db.Char(36)
  roleId         String       @db.Char(36)
  status         String       @default("ACTIVE") @db.VarChar(20)
  consumesSeat   Boolean      @default(true)
  joinedAt       DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, id])
  @@unique([userId, organizationId])
  @@index([organizationId, status])
}

model Role {
  id          String                   @id @default(uuid()) @db.Char(36)
  code        String                   @unique @db.VarChar(40)
  memberships Membership[]
  invitations OrganizationInvitation[]
  permissions RolePermission[]
}

model Permission {
  overrides MembershipPermissionOverride[]
  id    String           @id @default(uuid()) @db.Char(36)
  code  String           @unique @db.VarChar(80)
  roles RolePermission[]
}

enum PermissionOverrideEffect {
  GRANT
  REVOKE
}

model MembershipPermissionOverride {
  organizationId String @db.Char(36)
  membershipId String @db.Char(36)
  permissionId String @db.Char(36)
  effect PermissionOverrideEffect
  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([organizationId, membershipId, permissionId])
  @@index([permissionId])
}

model RolePermission {
  roleId       String     @db.Char(36)
  permissionId String     @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model OrganizationInvitation {
  invitedBy       User         @relation("InvitationAuthor", fields: [invitedByUserId], references: [id])
  id              String       @id @default(uuid()) @db.Char(36)
  organizationId  String       @db.Char(36)
  email           String       @db.VarChar(254)
  roleId          String       @db.Char(36)
  invitedByUserId String       @db.Char(36)
  status          String       @default("PENDING") @db.VarChar(20)
  tokenHash       String       @unique @db.Char(64)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id])
  role            Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId, status])
}

model Session {
  currentOrganization   Organization? @relation(fields: [currentOrganizationId], references: [id])
  id                    String        @id @default(uuid()) @db.Char(36)
  userId                String        @db.Char(36)
  tokenHash             String        @unique @db.Char(64)
  csrfHash              String        @db.Char(64)
  currentOrganizationId String?       @db.Char(36)
  createdAt             DateTime      @default(now())
  expiresAt             DateTime
  lastSeenAt            DateTime      @default(now())
  revokedAt             DateTime?
  user                  User          @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
}

model AuditEvent {
  targetMembershipId String? @db.Char(36)
  details Json?
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  actorUserId    String   @db.Char(36)
  action         String   @db.VarChar(80)
  occurredAt     DateTime @default(now())

  @@index([organizationId, occurredAt])
}

model SecurityEvent {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String?  @db.Char(36)
  type       String   @db.VarChar(80)
  occurredAt DateTime @default(now())

  @@index([userId, occurredAt])
}

enum ConversationStatus {
  OPEN
  PENDING
  ARCHIVED
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum HistoryVisibility {
  FULL
  LIMITED
  NONE
}

model Contact {
  id                String         @id @default(uuid()) @db.Char(36)
  organizationId    String         @db.Char(36)
  name              String         @db.VarChar(120)
  providerName      String?        @db.VarChar(120)
  primaryIdentifier String         @db.VarChar(254)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id])
  conversations     Conversation[]
  channelIdentities ContactIdentity[]
  authoredMessages Message[]

  @@unique([organizationId, id])
  @@unique([organizationId, primaryIdentifier])
}

model Conversation {
  id                 String                          @id @default(uuid()) @db.Char(36)
  organizationId     String                          @db.Char(36)
  contactId          String                          @db.Char(36)
  status             ConversationStatus              @default(OPEN)
  assignedUserId     String?                         @db.Char(36)
  archivedAt         DateTime?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  lastMessageAt      DateTime                        @default(now())
  visibility         HistoryVisibility               @default(FULL)
  channelId          String?                         @db.Char(36)
  providerConversationId String?                     @db.VarChar(120)
  providerMetadata   Json?
  historyBoundaryAt  DateTime?
  visibleFromMessage BigInt                          @default(0)
  visibleFromEvent   BigInt                          @default(0)
  organization       Organization                    @relation(fields: [organizationId], references: [id])
  contact            Contact                         @relation(fields: [organizationId, contactId], references: [organizationId, id])
  assignee           User?                           @relation("ConversationAssignee", fields: [assignedUserId], references: [id])
  messages           Message[]
  tags               ConversationTag[]
  notes              InternalNote[]
  assignments        ConversationAssignmentHistory[]
  channel            Channel?                        @relation(fields: [organizationId, channelId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, status, lastMessageAt, id])
  @@index([organizationId, assignedUserId, lastMessageAt, id])
  @@unique([organizationId, channelId, providerConversationId])
}

model Message {
  id              String        @id @default(uuid()) @db.Char(36)
  sequence        BigInt        @unique @default(autoincrement())
  organizationId  String        @db.Char(36)
  conversationId  String        @db.Char(36)
  senderUserId    String?       @db.Char(36)
  senderContactId String?       @db.Char(36)
  channelId       String?       @db.Char(36)
  providerMessageId String?     @db.VarChar(160)
  clientMessageId String?       @db.VarChar(100)
  direction       String        @default("INTERNAL") @db.VarChar(20)
  type            String        @default("TEXT") @db.VarChar(20)
  body            String?       @db.Text
  transmittedBody String?       @db.Text
  providerOccurredAt DateTime?
  historical      Boolean       @default(false)
  importedAt      DateTime      @default(now())
  mediaMetadata   Json?
  status          MessageStatus @default(SENT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  conversation    Conversation  @relation(fields: [organizationId, conversationId], references: [organizationId, id])
  sender          User?         @relation("MessageSender", fields: [senderUserId], references: [id])
  senderContact   Contact?      @relation(fields: [organizationId, senderContactId], references: [organizationId, id], onDelete: Restrict)
  channel         Channel?      @relation(fields: [organizationId, channelId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, conversationId, clientMessageId])
  @@index([organizationId, conversationId, sequence])
  @@index([organizationId, conversationId, createdAt, id])
  @@unique([organizationId, channelId, providerMessageId])
}

model Channel {
  id                    String            @id @default(uuid()) @db.Char(36)
  organizationId        String            @db.Char(36)
  provider              String            @db.VarChar(30)
  status                String            @default("DISABLED") @db.VarChar(20)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organization          Organization      @relation(fields: [organizationId], references: [id])
  conversations         Conversation[]
  messages              Message[]
  contactIdentities     ContactIdentity[]
  webConnection         ProviderConnection?

  @@unique([organizationId, id])
  @@unique([organizationId, provider])
}

model ProviderConnection {
  organizationId String @db.Char(36)
  channelId String @db.Char(36)
  state String @default("DISCONNECTED") @db.VarChar(24)
  version Int @default(1)
  providerRevision Int @default(0)
  qrRevision Int @default(0)
  lastCheckedAt DateTime?
  errorCode String? @db.VarChar(80)
  pairingPhase String? @db.VarChar(24)
  providerSync Json?
  syncProgress Json?
  pendingReceipts Json?
  leaseToken String? @db.Char(36)
  leaseUntil DateTime?
  channel Channel @relation(fields: [organizationId, channelId], references: [organizationId, id], onDelete: Restrict)
  commands ProviderCommand[]
  inbox ProviderInbox[]
  @@id([organizationId, channelId])
  @@index([leaseUntil])
}

model ProviderCommand {
  id String @id @db.Char(36)
  organizationId String @db.Char(36)
  channelId String @db.Char(36)
  actorUserId String @db.Char(36)
  sessionId String @db.Char(36)
  action String @db.VarChar(20)
  status String @default("PENDING") @db.VarChar(20)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  errorCode String? @db.VarChar(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  connection ProviderConnection @relation(fields: [organizationId, channelId], references: [organizationId, channelId], onDelete: Restrict)
  @@index([organizationId, channelId, status, nextAttemptAt])
}

model ProviderInbox {
  organizationId String @db.Char(36)
  channelId String @db.Char(36)
  deduplicationId String @db.Char(64)
  eventId String @db.Char(36)
  correlationId String @db.Char(36)
  type String @db.VarChar(40)
  dataHash String @db.Char(64)
  receivedAt DateTime @default(now())
  connection ProviderConnection @relation(fields: [organizationId, channelId], references: [organizationId, channelId], onDelete: Restrict)
  @@id([organizationId, channelId, deduplicationId])
  @@index([organizationId, channelId, receivedAt])
}

model ContactIdentity {
  organizationId String       @db.Char(36)
  channelId      String       @db.Char(36)
  contactId      String       @db.Char(36)
  externalId     String       @db.VarChar(120)
  createdAt      DateTime     @default(now())
  channel        Channel      @relation(fields: [organizationId, channelId], references: [organizationId, id], onDelete: Cascade)
  contact        Contact      @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, channelId, externalId])
  @@index([organizationId, channelId, contactId])
  @@index([organizationId, contactId])
}

model Tag {
  id             String            @id @default(uuid()) @db.Char(36)
  organizationId String            @db.Char(36)
  name           String            @db.VarChar(80)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id])
  conversations  ConversationTag[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model ConversationTag {
  organizationId String       @db.Char(36)
  conversationId String       @db.Char(36)
  tagId          String       @db.Char(36)
  conversation   Conversation @relation(fields: [organizationId, conversationId], references: [organizationId, id])
  tag            Tag          @relation(fields: [organizationId, tagId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, conversationId, tagId])
  @@index([organizationId, tagId, conversationId])
}

model InternalNote {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  conversationId String       @db.Char(36)
  authorUserId   String       @db.Char(36)
  body           String       @db.Text
  eventSequence  BigInt
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [organizationId, conversationId], references: [organizationId, id])
  author         User         @relation("NoteAuthor", fields: [authorUserId], references: [id])

  @@index([organizationId, conversationId, eventSequence])
}

model ConversationAssignmentHistory {
  id                 String            @id @default(uuid()) @db.Char(36)
  organizationId     String            @db.Char(36)
  conversationId     String            @db.Char(36)
  actorUserId        String            @db.Char(36)
  fromUserId         String?           @db.Char(36)
  toUserId           String            @db.Char(36)
  visibility         HistoryVisibility
  lastN              Int?
  visibleFromMessage BigInt
  note               String?           @db.VarChar(2000)
  createdAt          DateTime          @default(now())
  conversation       Conversation      @relation(fields: [organizationId, conversationId], references: [organizationId, id])
  actor              User              @relation("AssignmentActor", fields: [actorUserId], references: [id])

  @@index([organizationId, conversationId, createdAt])
}

model RealtimeEvent {
  id              BigInt       @id @default(autoincrement())
  audienceUserId  String?      @db.Char(36)
  organizationId  String       @db.Char(36)
  type            String       @db.VarChar(80)
  entityId        String       @db.Char(36)
  conversationId  String?      @db.Char(36)
  messageSequence BigInt?
  payload         Json
  version         Int          @default(1)
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, id])
}
